# Copy to .dev.vars for local development (never commit .dev.vars).

# The word friends spell on the board to unlock it. Letters and digits only; 5-8 letters is good.
BOARD_WORD=NIGHTJAR

# Any long random string. Signs the "this device knows the word" cookie.
COOKIE_SECRET=replace-me-with-a-long-random-string

# Your Anthropic API key. Leave empty and set MOCK_SPIRIT=1 to play with a canned spirit.
ANTHROPIC_API_KEY=

# 1 = canned replies, no API calls. 0 = the real spirit (needs ANTHROPIC_API_KEY).
MOCK_SPIRIT=1
